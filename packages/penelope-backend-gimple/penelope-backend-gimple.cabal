cabal-version: 3.0
name: penelope-backend-gimple
version: 0.1.1.0
synopsis: GCC -fgimple SSA tuples emission backend for Penelope
description:
  Direct code-generation backend lowering typed Penelope ASTs into
  GCC -fgimple SSA tuples with explicit virtual memory state.
license: EUPL-1.2
author: Nadia Yvette Chambers
maintainer: nadia.yvette.chambers@ik.me
category: Control
build-type: Simple
tested-with: GHC == 9.14.1

library
  exposed-modules:
    Penelope.Backend.Gimple
  hs-source-dirs: src
  default-language: Haskell2010
  default-extensions:
    BangPatterns
    DataKinds
    GADTs
    KindSignatures
    OverloadedStrings
    PolyKinds
    RankNTypes
    ScopedTypeVariables
  ghc-options: -Wall -Wcompat -Wredundant-constraints
  build-depends:
    base >= 4.14 && < 5,
    text >= 2.0 && < 2.2,
    primitive >= 0.9 && < 0.10,
    penelope-core,
    polytropos-core >= 0.1 && < 0.2

test-suite tests
  type: exitcode-stdio-1.0
  main-is: Spec.hs
  hs-source-dirs: test
  default-language: Haskell2010
  ghc-options: -Wall -Wcompat -Wredundant-constraints -threaded -rtsopts
  build-depends:
    base >= 4.14 && < 5,
    hspec >= 2.11 && < 2.12,
    primitive >= 0.9 && < 0.10,
    text >= 2.0 && < 2.2,
    penelope-core,
    penelope-backend-gimple,
    polytropos-core >= 0.1 && < 0.2,
    polytropos-plugin >= 0.1 && < 0.2
