cabal-version: 3.0
name: penelope-stage
version: 0.1.1.0
synopsis: 2LTT Staging & OrganIR Lowering Pipeline for Penelope
description:
  2-Level Type Theory staging engine lowering high-level Penelope ASTs
  to freestanding linear kernel and backend plugins.
license: EUPL-1.2
author: Nadia Yvette Chambers
maintainer: nadia.yvette.chambers@ik.me
category: Control
build-type: Simple
tested-with: GHC == 9.14.1

library
  exposed-modules:
    Penelope.Stage.OrganIR
  hs-source-dirs: src
  default-language: Haskell2010
  default-extensions:
    BangPatterns
    DataKinds
    GADTs
    KindSignatures
    OverloadedStrings
    PolyKinds
    RankNTypes
    ScopedTypeVariables
  ghc-options: -Wall -Wcompat -Wredundant-constraints
  build-depends:
    base >= 4.14 && < 5,
    text >= 2.0 && < 2.2,
    containers >= 0.6 && < 0.9,
    primitive >= 0.9 && < 0.10,
    penelope-core,
    polytropos-core >= 0.1 && < 0.2

test-suite tests
  type: exitcode-stdio-1.0
  main-is: Spec.hs
  hs-source-dirs: test
  default-language: Haskell2010
  ghc-options: -Wall -Wcompat -Wredundant-constraints -threaded -rtsopts
  build-depends:
    base >= 4.14 && < 5,
    hspec >= 2.11 && < 2.12,
    containers >= 0.6 && < 0.9,
    text >= 2.0 && < 2.2,
    penelope-core,
    penelope-stage,
    polytropos-core >= 0.1 && < 0.2,
    polytropos-plugin >= 0.1 && < 0.2
